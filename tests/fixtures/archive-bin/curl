  exit 22
fi

case " $* " in
*" https://api.e-hentai.org/api.php "*)
  printf '%s\n' \
    '{"gmetadata":[{"gid":123,"token":"test-token","title":"Test title","title_jpn":"","filecount":1,"expunged":false,"tags":["artist:test"],"rating":4.5}]}'
  ;;
*)
  printf '%s\n' '<a href="https://exhentai.org/g/123/test-token/">gallery</a>'
  ;;
esac
