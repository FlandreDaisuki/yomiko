#!/usr/bin/env bash
set -euo pipefail

if [[ "${MOCK_METADATA_FAILURE:-0}" == "1" ]]; then
  exit 22
fi

case " $* " in
*" https://api.e-hentai.org/api.php "*)
  if [[ "${MOCK_INVALID_METADATA:-0}" == "1" ]]; then
    printf '%s\n' \
      '{"gmetadata":[{"gid":123,"token":"test-token","title":"Test title","title_jpn":null,"filecount":"many","expunged":false,"tags":["artist:test"],"rating":"4.5"}]}'
    exit 0
  fi
  printf '%s\n' \
    '{"gmetadata":[{"gid":123,"token":"test-token","title":"Test title","title_jpn":null,"filecount":"1","expunged":false,"tags":["artist:test"],"rating":"4.5"}]}'
  ;;
*)
  printf '%s\n' '<a href="https://exhentai.org/g/123/test-token/">gallery</a>'
  ;;
esac
