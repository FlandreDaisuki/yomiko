#!/usr/bin/env bash

# Due to non-root crond has a loooooooot of bugs
# simulate by busy wait
# REF: https://github.com/gliderlabs/docker-alpine/issues/381

# https://git.busybox.net/busybox/plain/miscutils/crond.c?h=1_37_stable
# crond -L "${LOG_DIR}/crond.log" -l 2 -c "${CRONJOB_DIR}"

# shellcheck disable=SC1091
[[ -f "${HOME}/lib/path.sh" ]] && source "${HOME}/lib/path.sh"

# shellcheck disable=SC1091
[[ -f "${HOME}/lib/common.sh" ]] && source "${HOME}/lib/common.sh"

# shellcheck disable=SC1091
[[ -f "${HOME}/lib/variant_projection.sh" ]] && source "${HOME}/lib/variant_projection.sh"

# shellcheck disable=SC1091
[[ -f "${HOME}/lib/db.sh" ]] && source "${HOME}/lib/db.sh"
# shellcheck disable=SC1091
[[ -f "${HOME}/lib/metrics.sh" ]] && source "${HOME}/lib/metrics.sh"

printf 'Yomiko scheduler started; scanning every 300 seconds and processing at most 5 variant jobs every 60 seconds.\n'

prefix_scheduler_output() {
  local source="$1" line

  while IFS= read -r line || [[ -n "${line}" ]]; do
    printf '[%s] %s\n' "${source}" "${line}"
  done
}

tick=0
while true; do
  sleep 60s
  tick=$(((tick + 1) % 5))

  # Record the scheduler heartbeat before dispatching background work. A
  # telemetry failure must never stop the scheduler loop.
  metrics_runtime_run scheduler_tick true || true

  # * * * * *
  # Variant work has its own command lock and failure lifecycle. Run at most
  # five jobs per minute, independently so a scan cannot delay queued work.
  # Prefix each line so concurrent scan output stays identifiable.
  "${HOME}/bin/yomiko" variants work --max-jobs 5 2>&1 \
    | prefix_scheduler_output variants &

  # */5 * * * *
  if ((tick % 5 == 0)); then
    "${HOME}/bin/yomiko" scan "${HATH_DOWNLOAD_DIR}" 2>&1 \
      | prefix_scheduler_output scan &
  fi
done
