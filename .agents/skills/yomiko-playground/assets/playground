#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${YOMIKO_PLAYGROUND_ROOT:-}" ]]; then
	PLAYGROUND_ROOT="$(cd -- "${YOMIKO_PLAYGROUND_ROOT}" && pwd)"
else
	PLAYGROUND_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
fi
ENV_FILE="${PLAYGROUND_ROOT}/.yomiko-playground.env"
COMPOSE=(
	docker compose
	--env-file "${ENV_FILE}"
	-f "${PLAYGROUND_ROOT}/docker/docker-compose.playground.yaml"
)

read_env_value() {
	local key="$1"
	sed -n "s/^${key}=//p" "${ENV_FILE}" | sed -n '1p'
}

env_key_exists() {
	local key="$1"
	grep -Fqx "${key}=$(read_env_value "${key}")" "${ENV_FILE}"
}

COMPOSE_PROJECT_NAME="$(read_env_value COMPOSE_PROJECT_NAME)"
PLAYGROUND_NETWORK="${YOMIKO_PLAYGROUND_NETWORK:-$(read_env_value YOMIKO_PLAYGROUND_NETWORK)}"
if [[ -z "${PLAYGROUND_NETWORK}" ]]; then
	PLAYGROUND_NETWORK="${COMPOSE_PROJECT_NAME}_default"
fi
if [[ -n "${YOMIKO_NETWORK_PEER_CONTAINER+x}" ]]; then
	NETWORK_PEER_CONTAINER="${YOMIKO_NETWORK_PEER_CONTAINER}"
else
	NETWORK_PEER_CONTAINER="$(read_env_value YOMIKO_NETWORK_PEER_CONTAINER)"
	if ! env_key_exists YOMIKO_NETWORK_PEER_CONTAINER; then
		NETWORK_PEER_CONTAINER='prometheus'
	fi
fi

usage() {
	cat <<'EOF'
Usage: ./playground <COMMAND> [ARGUMENTS]

Commands:
  up       Build current code and start the isolated web playground
  down     Stop and remove only this playground's containers and network
  status   Show playground containers and the local web URL
  logs     Follow playground logs
  shell    Open Bash in the running playground container
  sql      Open SQLite, or run one noninteractive SQL string
  test     Build and run tests; accepts --filter TEXT and --trace
  exec     Run a noninteractive command in the playground container
  token    Print the generated playground API token
EOF
}

die_usage() {
	printf 'ERROR: %s\n' "$1" >&2
	usage >&2
	exit 2
}

require_no_arguments() {
	(($# == 0)) || die_usage "Command accepts no arguments: ${command_name}"
}

print_url() {
	local port
	port="$("${COMPOSE[@]}" port yomiko.playground 80 2>/dev/null | awk -F: 'END { print $NF }')"
	if [[ "${port}" =~ ^[0-9]+$ ]]; then
		printf 'URL: http://127.0.0.1:%s\n' "${port}"
	fi
}

network_peer_is_connected() {
	[[ -n "${NETWORK_PEER_CONTAINER}" ]] || return 1
	docker network inspect \
		--format '{{range .Containers}}{{println .Name}}{{end}}' \
		"${PLAYGROUND_NETWORK}" 2>/dev/null |
		grep -Fxq "${NETWORK_PEER_CONTAINER}"
}

connect_network_peer() {
	[[ -n "${NETWORK_PEER_CONTAINER}" ]] || return 0
	if ! docker inspect "${NETWORK_PEER_CONTAINER}" >/dev/null 2>&1; then
		printf 'Docker network peer not found; skipping: %s\n' \
			"${NETWORK_PEER_CONTAINER}" >&2
		return 0
	fi
	if network_peer_is_connected; then
		return 0
	fi
	docker network connect "${PLAYGROUND_NETWORK}" "${NETWORK_PEER_CONTAINER}"
}

disconnect_network_peer() {
	[[ -n "${NETWORK_PEER_CONTAINER}" ]] || return 0
	if ! docker inspect "${NETWORK_PEER_CONTAINER}" >/dev/null 2>&1 || \
		! docker network inspect "${PLAYGROUND_NETWORK}" >/dev/null 2>&1; then
		return 0
	fi
	if network_peer_is_connected; then
		docker network disconnect --force "${PLAYGROUND_NETWORK}" \
			"${NETWORK_PEER_CONTAINER}"
	fi
}

command_name="${1:-}"
if (($# > 0)); then
	shift
fi
case "${command_name}" in
up)
	require_no_arguments "$@"
	"${COMPOSE[@]}" up --build --detach yomiko.playground
	connect_network_peer
	"${COMPOSE[@]}" ps
	print_url
	;;
down)
	require_no_arguments "$@"
	DISCONNECT_STATUS=0
	disconnect_network_peer || DISCONNECT_STATUS=$?
	"${COMPOSE[@]}" down
	exit "${DISCONNECT_STATUS}"
	;;
status)
	require_no_arguments "$@"
	"${COMPOSE[@]}" ps
	print_url
	;;
logs)
	require_no_arguments "$@"
	"${COMPOSE[@]}" logs --follow yomiko.playground
	;;
shell)
	require_no_arguments "$@"
	"${COMPOSE[@]}" exec yomiko.playground bash
	;;
sql)
	(($# <= 1)) || die_usage 'sql accepts at most one SQL argument'
	if (($# == 0)); then
		"${COMPOSE[@]}" exec yomiko.playground \
			sqlite3 /home/yomiko/data/db.sqlite3
	else
		"${COMPOSE[@]}" exec --no-tty yomiko.playground \
			sqlite3 /home/yomiko/data/db.sqlite3 "$@"
	fi
	;;
test)
	test_filter=''
	test_filter_set=false
	trace_tests=false
	while (($# > 0)); do
		case "$1" in
		--filter)
			[[ "${test_filter_set}" == false ]] || die_usage 'Duplicate option: --filter'
			[[ -n "${2:-}" ]] || die_usage 'Missing value for --filter'
			test_filter="$2"
			test_filter_set=true
			shift 2
			;;
		--filter=*)
			[[ "${test_filter_set}" == false ]] || die_usage 'Duplicate option: --filter'
			test_filter="${1#*=}"
			[[ -n "${test_filter}" ]] || die_usage 'Missing value for --filter'
			test_filter_set=true
			shift
			;;
		--trace)
			trace_tests=true
			shift
			;;
		*) die_usage "Unknown test option: $1" ;;
		esac
	done
	"${COMPOSE[@]}" build yomiko.test
	test_run=("${COMPOSE[@]}" run --rm)
	if [[ "${test_filter_set}" == true ]]; then
		test_run+=(--env "YOMIKO_TEST_FILTER=${test_filter}")
	fi
	test_run+=(yomiko.test)
	if [[ "${trace_tests}" == true ]]; then
		test_run+=(bash -x /home/yomiko/tests/run.sh)
	fi
	"${test_run[@]}"
	;;
exec)
	(($# > 0)) || die_usage 'exec requires a command'
	"${COMPOSE[@]}" exec --no-tty yomiko.playground "$@"
	;;
token)
	require_no_arguments "$@"
	sed -n 's/^YOMIKO_API_TOKEN=//p' "${PLAYGROUND_ROOT}/.yomiko-playground.env"
	;;
-h | --help | help)
	require_no_arguments "$@"
	usage
	;;
*)
	usage >&2
	exit 2
	;;
esac
