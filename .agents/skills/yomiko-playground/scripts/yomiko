#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
CREATE_SCRIPT="${SCRIPT_DIR}/create_playground.sh"
METRICS_SCRIPT="${SCRIPT_DIR}/playground-metrics.sh"
PLAYGROUND_HELPER="${SKILL_DIR}/assets/playground"

usage() {
	cat <<'EOF'
Usage:
  yomiko create [--start] [DESTINATION]
  yomiko --playground PLAYGROUND_DIR <COMMAND> [ARGUMENTS]

Playground commands:
  up | down | status | logs | shell | token
  sql [SQL]
  test [--filter TEXT] [--trace]
  exec COMMAND [ARGUMENTS]
  metrics <enable|status|disable> [--keep-playground]

Run this repository-owned dispatcher for every playground operation so the
executable prefix remains stable even when PLAYGROUND_DIR is below /tmp.
EOF
}

die() {
	printf 'ERROR: %s\n' "$1" >&2
	exit 2
}

case "${1:-}" in
create)
	shift
	exec "${CREATE_SCRIPT}" "$@"
	;;
-h | --help | help)
	usage
	exit 0
	;;
esac

[[ "${1:-}" == '--playground' ]] || {
	usage >&2
	exit 2
}
[[ -n "${2:-}" ]] || die 'Missing value for --playground'
PLAYGROUND_DIR="$2"
shift 2

[[ -d "${PLAYGROUND_DIR}" ]] || die "Playground directory not found: ${PLAYGROUND_DIR}"
PLAYGROUND_DIR="$(cd -- "${PLAYGROUND_DIR}" && pwd)"
[[ -f "${PLAYGROUND_DIR}/.yomiko-playground.env" ]] || \
	die "Missing playground environment file: ${PLAYGROUND_DIR}/.yomiko-playground.env"
[[ -f "${PLAYGROUND_DIR}/docker/docker-compose.playground.yaml" ]] || \
	die "Missing playground Compose file: ${PLAYGROUND_DIR}/docker/docker-compose.playground.yaml"

COMMAND="${1:-}"
[[ -n "${COMMAND}" ]] || die 'Missing playground command'
shift

case "${COMMAND}" in
up | down | status | logs | shell | sql | test | exec | token)
	export YOMIKO_PLAYGROUND_ROOT="${PLAYGROUND_DIR}"
	exec "${PLAYGROUND_HELPER}" "${COMMAND}" "$@"
	;;
metrics)
	ACTION="${1:-}"
	[[ -n "${ACTION}" ]] || die 'Missing metrics action'
	shift
	exec bash "${METRICS_SCRIPT}" "${ACTION}" "${PLAYGROUND_DIR}" "$@"
	;;
*)
	printf 'ERROR: Unknown playground command: %s\n' "${COMMAND}" >&2
	usage >&2
	exit 2
	;;
esac
