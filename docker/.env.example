# REQUIRED: existing host directories containing downloads and archives
HOST_ARCHIVED_DIR=
HOST_HATH_DOWNLOAD_DIR=

# OPTIONAL: bind persistent application data to a host directory instead of
# the default Docker-managed yomiko-data volume
HOST_DATA_DIR=
# DEPRECATED: HOST_LOG_DIR no longer stores scheduler output.
# Use `docker compose logs` for scan and worker logs.
# It can still persist /home/yomiko/logs/yomiko-writer.log.
# Old scheduler log files remain but receive no new output.
# HOST_LOG_DIR=

# OPTIONAL: override the generated token persisted in yomiko-data
YOMIKO_API_TOKEN=

# OPTIONAL: container path to the mounted file containing the private
# Prometheus bearer token. The /run/secrets path is used by Docker Compose
# secrets; the corresponding secret mount must be configured separately.
# Example: YOMIKO_METRICS_TOKEN_FILE=/run/secrets/yomiko_metrics_token
YOMIKO_METRICS_TOKEN_FILE=

# OPTIONAL: set to false to run the CLI scan/archive loop without API or web
YOMIKO_ENABLE_WEB=true

# RESERVED FOR VARIANT ACTION PROCESSING: choose two distinct categories from
# 0 through 9. The current reporting-only variant worker does not use them yet.
YOMIKO_CANONICAL_FAVORITE_CATEGORY=
YOMIKO_ALTERNATE_FAVORITE_CATEGORY=

# OPTIONAL: 0.0.0.0 exposes the service on every host network interface
YOMIKO_BIND_ADDRESS=0.0.0.0
YOMIKO_PORT=62080

# OPTIONAL: image conversion resource settings
YOMIKO_CONVERSION_JOBS=4
MAGICK_MEMORY_LIMIT=1GiB
MAGICK_MAP_LIMIT=1GiB
MAGICK_THREAD_LIMIT=1
YOMIKO_7Z_MEMORY_LIMIT=

# OPTIONAL: SQLite and cooperative writer waits in milliseconds (default 5000,
# maximum 60000). Leave blank unless diagnosing database contention.
YOMIKO_SQLITE_BUSY_TIMEOUT_MS=
YOMIKO_DB_WRITER_GATE_TIMEOUT_MS=
