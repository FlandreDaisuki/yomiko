# REQUIRED: existing host directories containing downloads and archives
HOST_ARCHIVED_DIR=
HOST_HATH_DOWNLOAD_DIR=

# OPTIONAL: persistent application data and logs
HOST_DATA_DIR=./data
HOST_LOG_DIR=./logs

# REQUIRED for mutation API endpoints (for example: openssl rand -hex 32)
YOMIKO_API_TOKEN=

# OPTIONAL: set to false to run the CLI scan/archive loop without API or web
YOMIKO_ENABLE_WEB=true

# OPTIONAL: 0.0.0.0 exposes the service on every host network interface
YOMIKO_BIND_ADDRESS=0.0.0.0
YOMIKO_PORT=62080

# OPTIONAL: image conversion resource settings
YOMIKO_CONVERSION_JOBS=1
MAGICK_MEMORY_LIMIT=256MiB
MAGICK_MAP_LIMIT=256MiB
MAGICK_THREAD_LIMIT=1
YOMIKO_7Z_MEMORY_LIMIT=
