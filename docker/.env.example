# REQUIRED
HOST_ARCHIVED_DIR=
HOST_HATH_DOWNLOAD_DIR=

# REQUIRED for mutation API endpoints (for example: openssl rand -hex 32)
YOMIKO_API_TOKEN=

# OPTIONAL: keep the debug service local by default
YOMIKO_BIND_ADDRESS=0.0.0.0
YOMIKO_PORT=62080

# OPTIONAL: resource limits for the debug container and image conversion
YOMIKO_MEM_LIMIT=768m
YOMIKO_CONVERSION_JOBS=1
MAGICK_MEMORY_LIMIT=256MiB
MAGICK_MAP_LIMIT=256MiB
MAGICK_THREAD_LIMIT=1
