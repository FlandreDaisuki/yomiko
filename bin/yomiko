#!/usr/bin/env bash
set -euo pipefail

YOMIKO_SCRIPT_PATH="${BASH_SOURCE[0]}"
if [[ "${YOMIKO_SCRIPT_PATH}" != */* ]]; then
  YOMIKO_SCRIPT_PATH="$(command -v -- "${YOMIKO_SCRIPT_PATH}")"
fi
YOMIKO_ROOT="$(cd "$(dirname -- "${YOMIKO_SCRIPT_PATH}")/.." && pwd)"

# shellcheck disable=SC1091
source "${YOMIKO_ROOT}/lib/common.sh"

# shellcheck disable=SC1091
source "${YOMIKO_ROOT}/lib/path.sh"

# shellcheck disable=SC1091
source "${YOMIKO_ROOT}/lib/db.sh"

# shellcheck disable=SC1091
source "${YOMIKO_ROOT}/lib/exh.sh"

# shellcheck disable=SC1091
source "${YOMIKO_ROOT}/lib/variants.sh"

usage() {
  if yomiko_in_api_mode; then
    return 0
  fi

  cat <<EOF
Usage:
  yomiko scan <downloaded_dir>  Scan directory for completed downloads
  yomiko archive <gallery_dir>  Process, compress, and archive a gallery
  yomiko rate <gid> <1~10>      Rate a gallery and sync with ExHentai
  yomiko hath <gid>             Request a Hath download by gallery GID
  yomiko favorite <gid> <0~9>   Add a gallery to a favorites category
  yomiko login --cookie <str>   Store and validate ExHentai cookies
  yomiko whoami                 Test current ExHentai credentials
  yomiko feedback <gid> [opts]  Provide feedback for a downloaded gallery
                                Options:
                                  --rating <1~11>    Set self-rating and sync with ExHentai
                                  --favorite <0~9>   Add a gallery to a favorites category
                                  --dry-run          Print actions without making API, DB or file changes
  yomiko variants <command>     Manage durable gallery-variant work
                                Commands: enqueue, list, work
  yomiko repair-tags [opts]     Restore missing gallery tags from E-Hentai
                                Options:
                                  --max-count <1~5> Records to attempt (default and maximum: 5)
                                  --dry-run         Report affected records without API or DB changes
                                  --force           Skip confirmation for non-interactive use
  yomiko list [gid ...] [opts]  List galleries in the database
                                Options:
                                  --max-count <N>   Maximum number of records to return (default 50)
                                  --format <json|table> Output format, default json
                                  --pending-feedback List downloaded galleries without feedback
                                  --order-by <field>,<asc|desc> Sort list results
  yomiko help                   Show this message
EOF
}

# CLI validation helpers. Keep usage errors on exit status 1 and reject them
# before a command performs any network, database, or filesystem work.
cli_require_exact_argument_count() {
  local command="$1"
  local expected="$2"
  shift 2

  if [[ $# -lt "${expected}" ]]; then
    log_err "Missing argument for '${command}'. See 'yomiko help'."
    return 1
  fi

  if [[ $# -gt "${expected}" ]]; then
    local arguments=("$@")
    log_err "Unexpected argument: ${arguments[expected]}"
    return 1
  fi

  local argument
  for argument in "$@"; do
    if [[ -z "${argument}" ]]; then
      log_err "Missing argument for '${command}'. See 'yomiko help'."
      return 1
    fi
  done
}

cli_require_option_value() {
  local option="$1"
  local remaining_count="$2"
  local value="${3:-}"

  if [[ "${remaining_count}" -lt 2 || -z "${value}" || "${value}" == --* ]]; then
    log_err "Missing value for ${option}."
    return 1
  fi
}

cli_validate_gid() {
  local gid="$1"

  if [[ ! "${gid}" =~ ^[0-9]+$ ]]; then
    log_err "Invalid GID '${gid}'. Must be an unsigned integer."
    return 1
  fi
}

cli_validate_integer_range() {
  local label="$1"
  local value="$2"
  local minimum="$3"
  local maximum="$4"
  local normalized="${value}"

  if [[ ! "${normalized}" =~ ^(0|[1-9][0-9]*)$ ]]; then
    log_err "Invalid ${label} '${value}'. Must be ${minimum} through ${maximum}."
    return 1
  fi

  if [[ "${#normalized}" -gt "${#maximum}" ]] ||
    ((10#${normalized} < minimum || 10#${normalized} > maximum)); then
    log_err "Invalid ${label} '${value}'. Must be ${minimum} through ${maximum}."
    return 1
  fi
}

cli_validate_positive_integer() {
  local label="$1"
  local value="$2"

  if [[ ! "${value}" =~ ^[1-9][0-9]*$ ]]; then
    log_err "Invalid ${label} '${value}'. Must be a positive integer."
    return 1
  fi
}

# region Command Implementations

# yomiko login --cookie <cookie-string>
cmd_login() {
  local cookie_string=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --cookie=*)
      cookie_string="${1#*=}"
      if [[ -z "${cookie_string}" ]]; then
        log_err "Missing value for --cookie."
        exit 1
      fi
      shift
      ;;
    --cookie)
      cli_require_option_value "$1" "$#" "${2:-}" || exit 1
      cookie_string="${2:-}"
      shift 2
      ;;
    -*)
      log_err "Unknown option: $1"
      exit 1
      ;;
    *)
      log_err "Unexpected argument: $1"
      exit 1
      ;;
    esac
  done

  if [[ -z "${cookie_string}" ]]; then
    log_err "Missing cookie string. Usage: yomiko login --cookie <cookie-string>"
    exit 1
  fi

  local status_code
  if ! status_code=$(exh_refresh_cookies "${cookie_string}"); then
    log_err "Failed to validate ExHentai cookies."
    exit 2
  fi

  log "Cookies updated and validated with HTTP ${status_code}."
}

# yomiko whoami
cmd_whoami() {
  cli_require_exact_argument_count "whoami" 0 "$@" || exit 1

  local identity
  if ! identity=$(exh_whoami); then
    echo "${identity}"
    exit 1
  fi

  echo "${identity}"
}

# yomiko scan <hath_download_dir>
cmd_scan() (
  cli_require_exact_argument_count "scan" 1 "$@" || exit 1
  local hath_download_dir="$1"

  if [[ ! -d "${hath_download_dir}" ]]; then
    log_err "Directory '${hath_download_dir}' does not exist."
    exit 2
  fi

  local scan_lock_fd
  exec {scan_lock_fd}>"/tmp/yomiko-scan.lockfile"
  if ! flock -n "${scan_lock_fd}"; then
    log_err "A scan is already in progress."
    exit 75
  fi

  log "Scanning ${hath_download_dir}..."

  while read -r txt_path; do
    local gallery_dir archive_status
    gallery_dir="$(dirname "${txt_path}")"
    archive_status=0
    yomiko archive "${gallery_dir}" || archive_status=$?
    if [[ "${archive_status}" -eq 75 ]]; then
      log "Skipping gallery already being archived: ${gallery_dir}"
    elif [[ "${archive_status}" -ne 0 ]]; then
      return "${archive_status}"
    fi
  done < <(fd -t f 'galleryinfo.txt' "${hath_download_dir}")

  log "Scan and Archive complete."
)

gallery_upsert_metadata() {
  local gid="$1"
  local api_meta="$2"
  local file_path="${3:-}"
  local hath_requested_at="${4:-}"

  local normalized_meta
  if ! normalized_meta=$(exh_normalize_gallery_metadata "${gid}" "${api_meta}" 2>/dev/null); then
    log_err "Refusing to write invalid gallery metadata for GID: ${gid}"
    return 1
  fi

  local token title title_jpn_parameter file_count expunged tags rating updated_at
  local category uploader posted filesize thumb
  local first_gid first_key_parameter parent_gid parent_key_parameter current_gid current_key_parameter
  token=$(jq -r '.token' <<<"${normalized_meta}")
  title=$(jq -r '.title' <<<"${normalized_meta}")
  if jq -e '.title_jpn == null' >/dev/null <<<"${normalized_meta}"; then
    title_jpn_parameter="null"
  else
    title_jpn_parameter=$(db_parameter_text "$(jq -r '.title_jpn' <<<"${normalized_meta}")")
  fi
  file_count=$(jq -r '.filecount' <<<"${normalized_meta}")
  expunged=$(jq -r 'if .expunged then 1 else 0 end' <<<"${normalized_meta}")
  tags=$(jq -c '.tags' <<<"${normalized_meta}") # Store as a JSON array string.
  rating=$(jq -r '.rating' <<<"${normalized_meta}")
  category=$(jq -r '.category' <<<"${normalized_meta}")
  uploader=$(jq -r '.uploader' <<<"${normalized_meta}")
  posted=$(jq -r '.posted' <<<"${normalized_meta}")
  filesize=$(jq -r '.filesize' <<<"${normalized_meta}")
  thumb=$(jq -r '.thumb' <<<"${normalized_meta}")
  first_gid=$(jq -r '.first_gid // "null"' <<<"${normalized_meta}")
  parent_gid=$(jq -r '.parent_gid // "null"' <<<"${normalized_meta}")
  current_gid=$(jq -r '.current_gid // "null"' <<<"${normalized_meta}")
  if jq -e '.first_key == null' >/dev/null <<<"${normalized_meta}"; then
    first_key_parameter="null"
  else
    first_key_parameter=$(db_parameter_text "$(jq -r '.first_key' <<<"${normalized_meta}")")
  fi
  if jq -e '.parent_key == null' >/dev/null <<<"${normalized_meta}"; then
    parent_key_parameter="null"
  else
    parent_key_parameter=$(db_parameter_text "$(jq -r '.parent_key' <<<"${normalized_meta}")")
  fi
  if jq -e '.current_key == null' >/dev/null <<<"${normalized_meta}"; then
    current_key_parameter="null"
  else
    current_key_parameter=$(db_parameter_text "$(jq -r '.current_key' <<<"${normalized_meta}")")
  fi
  updated_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  db_query \
    ".parameter set :gid ${gid}" \
    ".parameter set :token $(db_parameter_text "${token}")" \
    ".parameter set :title $(db_parameter_text "${title}")" \
    ".parameter set :title_jpn ${title_jpn_parameter}" \
    ".parameter set :file_count ${file_count}" \
    ".parameter set :expunged ${expunged}" \
    ".parameter set :tags $(db_parameter_text "${tags}")" \
    ".parameter set :rating ${rating}" \
    ".parameter set :category $(db_parameter_text "${category}")" \
    ".parameter set :uploader $(db_parameter_text "${uploader}")" \
    ".parameter set :posted ${posted}" \
    ".parameter set :filesize ${filesize}" \
    ".parameter set :thumb $(db_parameter_text "${thumb}")" \
    ".parameter set :first_gid ${first_gid}" \
    ".parameter set :first_key ${first_key_parameter}" \
    ".parameter set :parent_gid ${parent_gid}" \
    ".parameter set :parent_key ${parent_key_parameter}" \
    ".parameter set :current_gid ${current_gid}" \
    ".parameter set :current_key ${current_key_parameter}" \
    ".parameter set :file_path $(db_parameter_text "${file_path}")" \
    ".parameter set :hath_requested_at $(db_parameter_text "${hath_requested_at}")" \
    ".parameter set :updated_at $(db_parameter_text "${updated_at}")" \
    'INSERT INTO galleries (
       gid, token, title, title_jpn, file_count, expunged, tags, rating,
       category, uploader, posted, filesize, thumb,
       first_gid, first_key, parent_gid, parent_key, current_gid, current_key,
       file_path, hath_requested_at, updated_at
     ) VALUES (
       :gid, :token, :title, :title_jpn, :file_count, :expunged, :tags, :rating,
       :category, :uploader, :posted, :filesize, :thumb,
       :first_gid, :first_key, :parent_gid, :parent_key, :current_gid, :current_key,
       :file_path, :hath_requested_at, :updated_at
     )
     ON CONFLICT(gid) DO UPDATE SET
       token = excluded.token,
       title = excluded.title,
       title_jpn = excluded.title_jpn,
       file_count = excluded.file_count,
       expunged = excluded.expunged,
       tags = excluded.tags,
       rating = excluded.rating,
       category = excluded.category,
       uploader = excluded.uploader,
       posted = excluded.posted,
       filesize = excluded.filesize,
       thumb = excluded.thumb,
       first_gid = excluded.first_gid,
       first_key = excluded.first_key,
       parent_gid = excluded.parent_gid,
       parent_key = excluded.parent_key,
       current_gid = excluded.current_gid,
       current_key = excluded.current_key,
       file_path = CASE
         WHEN length(excluded.file_path) = 0 THEN galleries.file_path
         ELSE excluded.file_path
       END,
       hath_requested_at = CASE
         WHEN length(excluded.hath_requested_at) = 0 THEN galleries.hath_requested_at
         ELSE excluded.hath_requested_at
       END,
       updated_at = excluded.updated_at;'
}

# Run archive work in a subshell so its EXIT trap and temporary state cannot
# leak into another command when this file is sourced.
# yomiko archive <gallery_dir>
cmd_archive() (
  cli_require_exact_argument_count "archive" 1 "$@" || exit 1
  local gallery_dir="$1"

  log "Archiving: ${gallery_dir}"

  if [[ ! -d "${gallery_dir}" ]]; then
    log_err "Directory '${gallery_dir}' does not exist."
    exit 2
  fi

  if [[ ! -f "${gallery_dir}/galleryinfo.txt" ]]; then
    log_err "Missing 'galleryinfo.txt' in '${gallery_dir}'."
    exit 3
  fi

  log "Processing: ${gallery_dir}"

  local path_meta
  if ! path_meta=$(exh_parse_path_meta "${gallery_dir}"); then
    log_err "Failed to parse path meta from directory name."
    exit 4
  fi

  local gid fs_compatible_title
  gid=$(echo "${path_meta}" | jq -r '.gid')
  fs_compatible_title=$(echo "${path_meta}" | jq -r '.fs_compatible_title')

  # Lock by GID in the system temporary directory. Lock files must remain in
  # place: removing one could let a third process lock a new inode while this
  # lock is still held.
  local archive_lock_path="/tmp/yomiko-archive-${gid}.lock"
  local archive_lock_fd
  exec {archive_lock_fd}>"${archive_lock_path}"
  if ! flock -n "${archive_lock_fd}"; then
    log_err "Gallery ${gid} is already being archived."
    exit 75
  fi

  local conversion_jobs="${YOMIKO_CONVERSION_JOBS:-4}"
  if [[ ! "${conversion_jobs}" =~ ^[1-9][0-9]*$ ]]; then
    log_err "Invalid YOMIKO_CONVERSION_JOBS '${conversion_jobs}'. Must be a positive integer."
    exit 1
  fi

  local seven_zip_memory_limit="${YOMIKO_7Z_MEMORY_LIMIT:-}"
  local seven_zip_memory_limit_kb
  if ! seven_zip_memory_limit_kb="$(memory_limit_to_kb "${seven_zip_memory_limit}")"; then
    log_err "Invalid YOMIKO_7Z_MEMORY_LIMIT '${seven_zip_memory_limit}'. Use an empty value or a positive KiB, MiB, or GiB value."
    exit 1
  fi

  local stage_dir=""
  local staged_archive=""
  # shellcheck disable=SC2317,SC2329 # Invoked indirectly by the EXIT trap.
  archive_cleanup() {
    local status=$?
    trap - EXIT INT TERM
    if [[ -n "${stage_dir}" ]]; then
      rm -rf -- "${stage_dir}"
    fi
    exit "${status}"
  }
  trap archive_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  # Keep staging on the archive filesystem so the final rename is atomic.
  stage_dir=$(mktemp -d "${ARCHIVED_DIR}/.yomiko-archive-${gid}.XXXXXX")
  staged_archive="${stage_dir}/archive.7z"

  # Fetch metadata before changing the gallery. A failed request therefore
  # leaves both the source directory and the installed archive untouched.
  local token api_meta
  if ! token=$(exh_get_token_by_gid "${gid}"); then
    log_err "Metadata fetch failed. Archive was not committed."
    exit 5
  fi
  if ! api_meta=$(exh_api_get_gallery_data "${gid}" "${token}"); then
    log_err "Metadata fetch failed. Archive was not committed."
    exit 5
  fi

  # region conversion and compression
  log "Converting images to WebP..."
  local webp_quality=75
  local webp_max_dimension=8196
  local encode_image_cmd="${YOMIKO_ROOT}/lib/encode_image.sh"

  # Limit conversion parallelism because each ImageMagick process can use substantial memory.
  # Write to a temporary sibling first so WebP-to-WebP compression never
  # reads from and writes to the same path at the same time.
  fd --threads "${conversion_jobs}" -t f -e jpg -e jpeg -e png -e gif -e webp . "${gallery_dir}" \
    -x bash "${encode_image_cmd}" \
    --quality "${webp_quality}" \
    --max-dimension "${webp_max_dimension}" \
    -- "{}"

  log "Compressing to 7z..."
  (
    if [[ -n "${seven_zip_memory_limit_kb}" ]]; then
      ulimit -v "${seven_zip_memory_limit_kb}"
    fi
    exec 7z a -bsp0 -bso0 "${staged_archive}" "${gallery_dir}/*.webp"
  )
  if [[ ! -f "${staged_archive}" ]]; then
    log_err "Compression completed without producing an archive."
    exit 6
  fi
  # endregion convertion and compression

  local db_field_file_path="[${gid}]${fs_compatible_title}.7z"
  local cleanup_record cleanup_self_rating cleanup_deleted_at
  cleanup_record=$(db_query_json \
    ".parameter set :gid ${gid}" \
    "SELECT self_rating, rated_then_deleted_at FROM galleries WHERE gid = :gid;")
  cleanup_self_rating=$(jq -r '.[0].self_rating // 0' <<<"${cleanup_record}")
  cleanup_deleted_at=$(jq -r '.[0].rated_then_deleted_at // empty' <<<"${cleanup_record}")

  log "Updating database for GID: ${gid}"
  gallery_upsert_metadata "${gid}" "${api_meta}" "${db_field_file_path}"

  if [[ "${cleanup_self_rating}" =~ ^([1-9]|10)$ && -n "${cleanup_deleted_at}" ]]; then
    log "Gallery ${gid} was already marked deleted after rating; discarding staged archive."
    rm -f -- "${ARCHIVED_DIR}/${db_field_file_path}"
  else
    # This is the commit point. The database update has succeeded and the
    # same-filesystem rename makes the completed archive visible atomically.
    mv -f -- "${staged_archive}" "${ARCHIVED_DIR}/${db_field_file_path}"
  fi

  rm -rf -- "${gallery_dir}"
  log "Successfully archived: ${gallery_dir}"
)

# yomiko rate <gid> <1~10>
cmd_rate() {
  cli_require_exact_argument_count "rate" 2 "$@" || exit 1
  local gid="$1"
  local rating="$2"

  cli_validate_gid "${gid}" || exit 1
  cli_validate_integer_range "rating" "${rating}" 1 10 || exit 1

  log "Rating gallery ${gid} as ${rating}..."

  local token
  if ! token=$(exh_get_token_by_gid "${gid}"); then
    log_err "Failed to get token for GID: ${gid}"
    exit 3
  fi

  if ! exh_rate "${gid}" "${token}" "${rating}"; then
    log_err "Failed to rate GID ${gid}."
    exit 4
  fi

  log "Successfully rated GID ${gid} as ${rating}."
}

# yomiko hath <gid>
cmd_hath() {
  cli_require_exact_argument_count "hath" 1 "$@" || exit 1
  local gid="$1"
  cli_validate_gid "${gid}" || exit 1

  log "Requesting Hath download for GID: ${gid}"

  local token
  if ! token=$(exh_get_token_by_gid "${gid}"); then
    log_err "Failed to get token for GID: ${gid}"
    exit 2
  fi

  local api_meta
  if ! api_meta=$(exh_api_get_gallery_data "${gid}" "${token}"); then
    log_err "Failed to get gallery metadata for GID: ${gid}"
    exit 3
  fi

  if ! exh_request_hath_download "${gid}" "${token}"; then
    log_err "Failed to request download for GID: ${gid}"
    exit 4
  fi

  log "Writing requested gallery metadata for GID: ${gid}"
  gallery_upsert_metadata "${gid}" "${api_meta}" "" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

  log "Hath download successfully requested for GID: ${gid}"
}

# yomiko favorite <gid> <0~9>
# Logic: Adds gallery to specified ExHentai favorites category
cmd_favorite() {
  cli_require_exact_argument_count "favorite" 2 "$@" || exit 1
  local gid="$1"
  local favcat="$2"

  cli_validate_gid "${gid}" || exit 1
  cli_validate_integer_range "favorite category" "${favcat}" 0 9 || exit 1

  log "Adding GID ${gid} to favorite category ${favcat}"

  local token
  if ! token=$(exh_get_token_by_gid "${gid}"); then
    log_err "Failed to get token for GID: ${gid}"
    exit 3
  fi

  if ! exh_add_favorite "${gid}" "${token}" "${favcat}"; then
    log_err "Failed to add GID ${gid} to favorites."
    exit 4
  fi

  log "Successfully added GID ${gid} to favorites category ${favcat}."
}

# yomiko feedback <gid> [--rating=<1-11>] [--favorite=<0-9>] [--dry-run]
cmd_feedback() {
  local gid=""
  local rating=""
  local favcat=""
  local dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --rating=*)
      rating="${1#*=}"
      if [[ -z "${rating}" ]]; then
        log_err "Missing value for --rating."
        exit 1
      fi
      shift
      ;;
    --rating)
      cli_require_option_value "$1" "$#" "${2:-}" || exit 1
      rating="${2:-}"
      shift 2
      ;;
    --favorite=*)
      favcat="${1#*=}"
      if [[ -z "${favcat}" ]]; then
        log_err "Missing value for --favorite."
        exit 1
      fi
      shift
      ;;
    --favorite)
      cli_require_option_value "$1" "$#" "${2:-}" || exit 1
      favcat="${2:-}"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -*)
      log_err "Unknown option: $1"
      exit 1
      ;;
    *)
      if [[ -z "${gid}" ]]; then
        gid="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "${gid}" ]]; then
    log_err "Missing GID for feedback. Usage: yomiko feedback <gid> [options]"
    exit 1
  fi

  cli_validate_gid "${gid}" || exit 1
  if [[ -n "${rating}" ]]; then
    cli_validate_integer_range "rating" "${rating}" 1 11 || exit 1
  fi
  if [[ -n "${favcat}" ]]; then
    cli_validate_integer_range "favorite category" "${favcat}" 0 9 || exit 1
  fi

  log "Ready to execute feedback logic for GID: ${gid} (Rating: ${rating:-none}, Favorite: ${favcat:-none}, Dry Run: ${dry_run})"

  local db_record token file_path
  db_record=$(db_query_json \
    ".parameter set :gid ${gid}" \
    "SELECT token, file_path FROM galleries WHERE gid = :gid;")
  if [[ -z "${db_record}" || "${db_record}" == "[]" ]]; then
    log_err "Gallery GID ${gid} not found in database."
    exit 4
  fi

  token=$(jq -r '.[0].token // empty' <<<"${db_record}")
  file_path=$(jq -r '.[0].file_path // empty' <<<"${db_record}")

  # High feedback still performs source cleanup on this request path, so reject
  # unsafe archive names before persisting its durable intent. Low feedback is
  # checked after group routing because grouped cleanup belongs to the worker.
  if [[ -n "${rating}" && "${rating}" -ge 8 && "${rating}" -le 10 && -n "${file_path}" ]] &&
    ! archive_filename_is_safe "${file_path}"; then
    log_err "Refusing to delete an invalid archive path for GID ${gid}."
    exit 4
  fi

  local variant_queued=false
  local variant_group_id=null
  local is_variant_feedback=0
  if [[ -n "${rating}" && "${rating}" -ge 8 ]]; then
    is_variant_feedback=1
  fi

  # Ratings 8 through 11 are durable intent. The worker performs remote rating
  # and desired-state favorite actions; feedback must not wait on the network.
  if [[ "${is_variant_feedback}" -eq 1 ]]; then
    if [[ "${dry_run}" -eq 1 ]]; then
      log "[Dry Run] Would persist rating ${rating} and queue variant discovery and remote actions for GID ${gid}"
      if [[ -n "${favcat}" ]]; then
        log "[Dry Run] Favorite ${favcat} would not be submitted directly; variant favorite routing uses configured canonical and alternate categories"
      fi
    else
      log "Persisting feedback and queueing variant work for GID ${gid}..."
      variant_group_id="$(variants_enqueue_feedback "${gid}" "${rating}")" || exit 5
      variant_queued=true
    fi
  elif [[ -n "${rating}" ]]; then
    # A low rating on a confirmed member is group intent. Resolve dry runs with
    # the same ordering as variants_downgrade_feedback, but do not mutate. A
    # real status 3 is the explicit signal to retain the legacy single-gallery
    # synchronous behavior below; every other failure is fatal.
    if [[ "${dry_run}" -eq 1 ]]; then
      if ! variant_group_id="$(db_query \
        ".parameter set :gid ${gid}" \
        "SELECT grouped.id
           FROM gallery_variants AS member
           JOIN variant_groups AS grouped ON grouped.id = member.group_id
          WHERE member.gid = :gid
            AND member.membership_state = 'confirmed'
          ORDER BY grouped.is_active DESC, grouped.id
          LIMIT 1;")"; then
        log_err "Failed to inspect variant membership for GID ${gid}."
        exit 5
      fi
      if [[ -n "${variant_group_id}" ]]; then
        if [[ ! "${variant_group_id}" =~ ^[1-9][0-9]*$ ]]; then
          log_err "Invalid variant group returned for GID ${gid}."
          exit 5
        fi
        is_variant_feedback=1
        variant_queued=true
        log "[Dry Run] Would deactivate variant group ${variant_group_id}, propagate rating ${rating}, and queue remote and archive actions"
      else
        variant_group_id=null
      fi
    else
      local downgrade_status=0
      variant_group_id="$(variants_downgrade_feedback "${gid}" "${rating}")" || downgrade_status=$?
      case "${downgrade_status}" in
      0)
        is_variant_feedback=1
        variant_queued=true
        log "Persisted rating ${rating} and queued downgrade actions for variant group ${variant_group_id}."
        ;;
      "${VARIANTS_NOT_GROUPED_STATUS}")
        variant_group_id=null
        ;;
      *)
        log_err "Failed to apply variant-group downgrade for GID ${gid}."
        exit 5
        ;;
      esac
    fi
  fi

  # Only an ungrouped low rating uses the legacy immediate-delete path. Keep
  # its archive validation before any remote, database, or filesystem change.
  if [[ "${is_variant_feedback}" -eq 0 && -n "${rating}" && "${rating}" -le 7 && -n "${file_path}" ]] &&
    ! archive_filename_is_safe "${file_path}"; then
    log_err "Refusing to delete an invalid archive path for GID ${gid}."
    exit 4
  fi

  if [[ "${is_variant_feedback}" -eq 0 && -n "${rating}" ]]; then
    local api_rating="${rating}"

    if [[ "${dry_run}" -eq 0 ]]; then
      log "Submitting rating ${api_rating} for GID ${gid}..."
      if ! exh_rate "${gid}" "${token}" "${api_rating}"; then
        log_err "Failed to rate GID ${gid}."
      fi
    else
      log "[Dry Run] Would rate GID ${gid} as ${api_rating} (User rating: ${rating})"
    fi
  fi

  # Preserve the existing single-gallery update and deletion behavior below 8.
  if [[ "${is_variant_feedback}" -eq 0 && "${dry_run}" -eq 0 ]]; then
    local sql
    if [[ -n "${rating}" ]]; then
      if [[ "${rating}" -le 10 ]]; then
        sql="UPDATE galleries SET
          feedbacked_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
          self_rating = :rating,
          rated_then_deleted_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
        WHERE gid = :gid;"
      else
        sql="UPDATE galleries SET
          feedbacked_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
          self_rating = :rating
        WHERE gid = :gid;"
      fi
    else
      sql="UPDATE galleries SET feedbacked_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')) WHERE gid = :gid;"
    fi

    log "Updating database for GID ${gid}..."
    if [[ -n "${rating}" ]]; then
      db_query \
        ".parameter set :rating ${rating}" \
        ".parameter set :gid ${gid}" \
        "${sql}"
    else
      db_query \
        ".parameter set :gid ${gid}" \
        "${sql}"
    fi

    if [[ -n "${rating}" ]]; then
      # shellcheck disable=SC2153
      if [[ -n "${file_path}" ]]; then
        local archive_file="${ARCHIVED_DIR}/${file_path}"
        if [[ ! -f "${archive_file}" ]]; then
          log_err "Archive file not found, treating as already absent: ${archive_file}"
        else
          log "Deleting local file: ${archive_file}"
        fi
        rm -f "${archive_file}"
      else
        log_err "No archive file recorded for GID ${gid}; treating as already absent."
      fi
    fi

    log "Feedback processed successfully for GID ${gid}."
  elif [[ "${is_variant_feedback}" -eq 0 ]]; then
    log "[Dry Run] Would update database for GID ${gid}"
    if [[ -n "${rating}" && -n "${file_path}" ]]; then
      # shellcheck disable=SC2153
      log "[Dry Run] Would delete file: ${ARCHIVED_DIR}/${file_path}"
    elif [[ -n "${rating}" ]]; then
      log "[Dry Run] Would confirm no archive file is recorded for GID ${gid}"
    fi
  fi

  # Ratings 8 through 10 retain their existing delete-on-feedback meaning, but
  # completion is recorded only after an archive was actually removed. Rating
  # 11 deliberately retains the source until variant retention is reconciled.
  if [[ "${is_variant_feedback}" -eq 1 && "${rating}" -ge 8 && "${rating}" -le 10 ]]; then
    # shellcheck disable=SC2153
    local archive_file="${ARCHIVED_DIR}/${file_path}"
    if [[ -z "${file_path}" || ! -f "${archive_file}" ]]; then
      if [[ "${dry_run}" -eq 1 ]]; then
        log "[Dry Run] No existing archive would be deleted for GID ${gid}; rated_then_deleted_at would remain unchanged"
      else
        log "No existing archive deleted for GID ${gid}; rated_then_deleted_at remains unchanged."
      fi
    elif [[ "${dry_run}" -eq 1 ]]; then
      log "[Dry Run] Would delete file: ${archive_file}, then record rated_then_deleted_at"
    else
      log "Deleting local file: ${archive_file}"
      if ! rm -- "${archive_file}"; then
        log_err "Failed to delete local file: ${archive_file}"
        exit 6
      fi
      db_query \
        ".parameter set :gid ${gid}" \
        "UPDATE galleries SET
           rated_then_deleted_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now'),
           updated_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now')
         WHERE gid = :gid;"
    fi
  elif [[ "${is_variant_feedback}" -eq 1 && "${rating}" -eq 11 ]]; then
    if [[ "${dry_run}" -eq 1 ]]; then
      log "[Dry Run] Would retain the source archive for GID ${gid}"
    else
      log "Retaining the source archive for rating 11."
    fi
  fi

  if yomiko_in_api_mode; then
    printf '{"variant_queued":%s,"variant_group_id":%s}\n' \
      "${variant_queued}" "${variant_group_id}"
  fi
}

# yomiko repair-tags [--max-count <N>] [--dry-run]
cmd_repair_tags() {
  local max_count=5
  local dry_run=0
  local force=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --max-count=*)
      max_count="${1#*=}"
      if [[ -z "${max_count}" ]]; then
        log_err "Missing value for --max-count."
        exit 1
      fi
      shift
      ;;
    --max-count)
      cli_require_option_value "$1" "$#" "${2:-}" || exit 1
      max_count="${2:-}"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --force)
      force=1
      shift
      ;;
    -*)
      log_err "Unknown option: $1"
      exit 1
      ;;
    *)
      log_err "Unexpected argument: $1"
      exit 1
      ;;
    esac
  done

  cli_validate_integer_range "max count" "${max_count}" 1 5 || exit 1

  local schema_version
  if ! schema_version="$(db_query "SELECT MAX(version) FROM _schema_version;")"; then
    log_err "Failed to read the current database schema version."
    return 1
  fi
  if [[ ! "${schema_version}" =~ ^[0-9]+$ || "${schema_version}" -lt 4 ]]; then
    log_err "Tag repair requires database schema migration 004 or newer."
    return 1
  fi

  local total
  total="$(db_query "SELECT COUNT(*) FROM galleries WHERE tags IS NULL;")"
  log "Migration 004 prevents new invalid tags but does not backfill legacy null values."
  log "Gallery records needing tag repair: ${total}."

  local records
  records="$(db_query_json \
    ".parameter set :max_count ${max_count}" \
    "SELECT gid, token FROM galleries WHERE tags IS NULL ORDER BY gid LIMIT :max_count;")"
  : "${records:=[]}"

  local selected
  selected="$(jq 'length' <<<"${records}")"
  if [[ "${dry_run}" -eq 1 ]]; then
    log "Would attempt tag repair for ${selected} gallery record(s) in this run."
    return 0
  fi

  if [[ "${selected}" -eq 0 ]]; then
    log "Tag repair complete: 0 repaired, 0 failed, 0 remaining."
    return 0
  fi

  if [[ "${force}" -eq 0 ]]; then
    local confirmation=""
    printf 'Repair tags for %s gallery record(s) now? [y/N] ' "${selected}" >&2
    IFS= read -r confirmation || confirmation=""
    case "${confirmation,,}" in
    y | yes) ;;
    *)
      log "Tag repair cancelled. Use --force for non-interactive execution."
      return 1
      ;;
    esac
  fi

  local repaired=0
  local failed=0
  local record gid token metadata tags
  while IFS= read -r record; do
    gid="$(jq -r '.gid' <<<"${record}")"
    token="$(jq -r '.token // empty' <<<"${record}")"
    if [[ -z "${token}" ]]; then
      log_err "Cannot repair tags for GID ${gid}: gallery token is missing."
      failed=$((failed + 1))
      continue
    fi

    log "Fetching tags for GID: ${gid}"
    if ! metadata="$(exh_api_get_gallery_data "${gid}" "${token}")"; then
      log_err "Failed to fetch tags for GID: ${gid}"
      failed=$((failed + 1))
      continue
    fi
    tags="$(jq -c '.tags' <<<"${metadata}")"

    if db_query \
      ".parameter set :gid ${gid}" \
      ".parameter set :tags $(db_parameter_text "${tags}")" \
      "UPDATE galleries SET tags = :tags WHERE gid = :gid AND tags IS NULL;"; then
      repaired=$((repaired + 1))
    else
      log_err "Failed to write repaired tags for GID: ${gid}"
      failed=$((failed + 1))
    fi
  done < <(jq -c '.[]' <<<"${records}")

  local remaining
  remaining="$(db_query "SELECT COUNT(*) FROM galleries WHERE tags IS NULL;")"
  log "Tag repair complete: ${repaired} repaired, ${failed} failed, ${remaining} remaining."
  [[ "${failed}" -eq 0 ]]
}

# yomiko list [gid ...] [opts]
cmd_list() {
  local max_count=50
  local format="json"
  local pending_feedback=0
  local order_by=""
  local gids=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --max-count=*)
      max_count="${1#*=}"
      if [[ -z "${max_count}" ]]; then
        log_err "Missing value for --max-count."
        exit 1
      fi
      shift
      ;;
    --max-count)
      cli_require_option_value "$1" "$#" "${2:-}" || exit 1
      max_count="${2:-}"
      shift 2
      ;;
    --format=*)
      format="${1#*=}"
      if [[ -z "${format}" ]]; then
        log_err "Missing value for --format."
        exit 1
      fi
      shift
      ;;
    --format)
      cli_require_option_value "$1" "$#" "${2:-}" || exit 1
      format="${2:-}"
      shift 2
      ;;
    --pending-feedback)
      pending_feedback=1
      shift
      ;;
    --order-by=*)
      order_by="${1#*=}"
      if [[ -z "${order_by}" ]]; then
        log_err "Missing value for --order-by."
        exit 1
      fi
      shift
      ;;
    --order-by)
      cli_require_option_value "$1" "$#" "${2:-}" || exit 1
      order_by="${2:-}"
      shift 2
      ;;
    -*)
      log_err "Unknown option: $1"
      exit 1
      ;;
    *)
      gids+=("$1")
      shift
      ;;
    esac
  done

  cli_validate_positive_integer "max count" "${max_count}" || exit 1

  local gid
  for gid in "${gids[@]}"; do
    cli_validate_gid "${gid}" || exit 1
  done

  local order_clause="ORDER BY gid"
  if [[ -n "${order_by}" ]]; then
    local order_field order_direction order_extra
    IFS=',' read -r order_field order_direction order_extra <<<"${order_by}"

    if [[ -z "${order_field}" || -z "${order_direction}" || -n "${order_extra}" ]]; then
      log_err "Invalid order-by '${order_by}'. Expected <field>,<asc|desc>."
      exit 1
    fi

    case "${order_field}" in
    gid | token | title | title_jpn | file_count | expunged | tags | rating | file_path | self_rating | created_at | updated_at | rated_then_deleted_at | feedbacked_at | hath_requested_at) ;;
    *)
      log_err "Invalid order-by field '${order_field}'."
      exit 1
      ;;
    esac

    case "${order_direction,,}" in
    asc | desc)
      order_direction="${order_direction^^}"
      ;;
    *)
      log_err "Invalid order-by direction '${order_direction}'."
      exit 1
      ;;
    esac

    order_clause="ORDER BY ${order_field} ${order_direction}"
    if [[ "${order_field}" != "gid" ]]; then
      order_clause="${order_clause}, gid ${order_direction}"
    fi
  fi

  # Build SQL query
  local sql="SELECT * FROM galleries ${order_clause} LIMIT :max_count;"
  local where_clause=""
  if [[ ${#gids[@]} -gt 0 ]]; then
    local gid_prepared_list
    gid_prepared_list=$(
      jq -nr --arg gids "${gids[*]}" '$gids | split(" ") | map(select(test("^\\d+$"))) | join(",")'
    )
    where_clause="gid IN (${gid_prepared_list})"
  fi

  if [[ "${pending_feedback}" -eq 1 ]]; then
    local pending_clause="length(COALESCE(file_path, '')) > 0
      AND COALESCE(feedbacked_at, '') = ''
      AND COALESCE(self_rating, 0) = 0"
    if [[ -n "${where_clause}" ]]; then
      where_clause="${where_clause} AND ${pending_clause}"
    else
      where_clause="${pending_clause}"
    fi
  fi

  if [[ -n "${where_clause}" ]]; then
    if [[ -z "${order_by}" ]]; then
      order_clause="ORDER BY updated_at DESC, gid DESC"
    fi
    sql="SELECT * FROM galleries WHERE ${where_clause} ${order_clause} LIMIT :max_count;"
  fi

  if [[ "$format" == "json" ]]; then
    local output
    output=$(db_query_json \
      ".parameter set :max_count ${max_count}" \
      "$sql")
    if [[ -z "${output}" ]]; then
      echo "[]"
    else
      echo "${output}"
    fi
  elif [[ "$format" == "table" ]]; then
    log_err "TODO: Table format is not implemented yet."
    exit 1
  else
    log_err "Invalid format: $format"
    exit 1
  fi
}

# endregion Command Implementations

# region CLI entry

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

COMMAND="$1"
shift

case "${COMMAND}" in
login) cmd_login "$@" ;;
whoami) cmd_whoami "$@" ;;
scan) cmd_scan "$@" ;;
archive) cmd_archive "$@" ;;
rate) cmd_rate "$@" ;;
hath) cmd_hath "$@" ;;
favorite) cmd_favorite "$@" ;;
feedback) cmd_feedback "$@" ;;
variants) cmd_variants "$@" ;;
repair-tags) cmd_repair_tags "$@" ;;
list) cmd_list "$@" ;;
help | --help | -h) usage ;;
*)
  log_err "Unknown command: ${COMMAND}"
  usage >&2
  exit 1
  ;;
esac

# endregion CLI entry
