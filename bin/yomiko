#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1091
[[ -f "${HOME}/lib/path.sh" ]] && source "${HOME}/lib/path.sh"

# shellcheck disable=SC1091
[[ -f "${HOME}/lib/db.sh" ]] && source "${HOME}/lib/db.sh"

# shellcheck disable=SC1091
[[ -f "${HOME}/lib/exh.sh" ]] && source "${HOME}/lib/exh.sh"

: "${YOMIKO_CLI_IN_API_MODE:=}"

# Log message if YOMIKO_CLI_IN_API_MODE is empty; silent otherwise
log() {
  if [[ -z "${YOMIKO_CLI_IN_API_MODE:-}" ]]; then
    echo "$*"
  fi
}

log_err() {
  log "ERROR: $*" >&2
}

usage() {
  if [[ -n "${YOMIKO_CLI_IN_API_MODE:-}" ]]; then
    return 0
  fi

  cat <<EOF
Usage:
  yomiko scan <downloaded_dir>  Scan directory for completed downloads
  yomiko archive <gallery_dir>  Process, compress, and archive a gallery
  yomiko rate <gid> <1~10>      Rate a gallery and sync with ExHentai
  yomiko pull <gid>             Request a gallery download by GID
  yomiko favorite <gid> <0~9>   Add a gallery to a favorites category
  yomiko login --cookie <str>   Store and validate ExHentai cookies
  yomiko whoami                 Test current ExHentai credentials
  yomiko feedback <gid> [opts]  Provide feedback for a downloaded gallery
                                Options:
                                  --rating <1~11>    Set self-rating and sync with ExHentai
                                  --favorite <0~9>   Add a gallery to a favorites category
                                  --dry-run          Print actions without making API, DB or file changes
  yomiko list [gid ...] [opts]  List galleries in the database
                                Options:
                                  --max-count <N>   Maximum number of records to return (default 50)
                                  --format <json|table> Output format, default json
  yomiko help                   Show this message
EOF
}

# region Command Implementations

# yomiko login --cookie <cookie-string>
cmd_login() {
  local cookie_string=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --cookie=*)
      cookie_string="${1#*=}"
      shift
      ;;
    --cookie)
      if [[ $# -lt 2 ]]; then
        log_err "Missing value for --cookie."
        exit 1
      fi
      cookie_string="${2:-}"
      shift 2
      ;;
    -*)
      log_err "Unknown option: $1"
      exit 1
      ;;
    *)
      log_err "Unexpected argument: $1"
      exit 1
      ;;
    esac
  done

  if [[ -z "${cookie_string}" ]]; then
    log_err "Missing cookie string. Usage: yomiko login --cookie <cookie-string>"
    exit 1
  fi

  local status_code
  if ! status_code=$(exh_refresh_cookies "${cookie_string}"); then
    log_err "Failed to validate ExHentai cookies."
    exit 2
  fi

  log "Cookies updated and validated with HTTP ${status_code}."
}

# yomiko whoami
cmd_whoami() {
  if [[ $# -gt 0 ]]; then
    log_err "Unexpected argument: $1"
    exit 1
  fi

  local identity
  if ! identity=$(exh_whoami); then
    echo "${identity}"
    exit 1
  fi

  echo "${identity}"
}

# yomiko scan <hath_download_dir>
cmd_scan() {
  local hath_download_dir="${1:-}"
  if [[ -z "${hath_download_dir}" ]]; then
    log_err 'Missing directory to scan.'
    exit 1
  fi

  if [[ ! -d "${hath_download_dir}" ]]; then
    log_err "Directory '${hath_download_dir}' does not exist."
    exit 2
  fi

  log "Scanning ${hath_download_dir}..."

  while read -r txt_path; do
    local gallery_dir
    gallery_dir="$(dirname "${txt_path}")"
    yomiko archive "${gallery_dir}"
  done < <(fd -t f 'galleryinfo.txt' "${hath_download_dir}")

  log "Scan and Archive complete."
}

# yomiko archive <gallery_dir>
cmd_archive() {
  local gallery_dir="${1:-}"
  if [[ -z "${gallery_dir}" ]]; then
    log_err "Missing gallery directory."
    exit 1
  fi

  log "Archiving: ${gallery_dir}"

  if [[ ! -d "${gallery_dir}" ]]; then
    log_err "Directory '${gallery_dir}' does not exist."
    exit 2
  fi

  if [[ ! -f "${gallery_dir}/galleryinfo.txt" ]]; then
    log_err "Missing 'galleryinfo.txt' in '${gallery_dir}'."
    exit 3
  fi

  log "Processing: ${gallery_dir}"

  local path_meta
  if ! path_meta=$(exh_parse_path_meta "${gallery_dir}"); then
    log_err "Failed to parse path meta from directory name."
    exit 4
  fi

  local gid fs_compatible_title
  gid=$(echo "${path_meta}" | jq -r '.gid')
  fs_compatible_title=$(echo "${path_meta}" | jq -r '.fs_compatible_title')

  # region background fetch
  local metadata_tmp
  metadata_tmp=$(mktemp)
  (
    if token=$(exh_get_token_by_gid "$gid"); then
      if data=$(exh_api_get_gallery_data "$gid" "$token"); then
        echo "$data" >"$metadata_tmp"
        exit 0
      fi
    fi
    exit 1
  ) &
  local bg_fetch_pid=$!
  # endregion background fetch

  # region convertion and compression
  log "Converting images to WebP..."
  # fd finds images and executes magick conversion in parallel
  fd -t f -e jpg -e jpeg -e png -e gif -e webp . "${gallery_dir}" \
    -x magick "{}" -quality 75 "{.}.webp"

  log "Compressing to 7z..."
  local tmp_dir
  tmp_dir=$(mktemp -d)
  7z a -bsp0 -bso0 "${tmp_dir}/webp.7z" "${gallery_dir}/*.webp"

  local db_field_file_path="${fs_compatible_title}.7z"
  mv "${tmp_dir}/webp.7z" "${ARCHIVED_DIR}/${db_field_file_path}"
  # endregion convertion and compression

  wait "${bg_fetch_pid}"
  local bg_fetch_status=$?

  if [[ "${bg_fetch_status}" -ne 0 ]]; then
    log_err "Metadata fetch failed. Archiving local file only."
    rm -f "${metadata_tmp}"
    exit 5
  fi

  local api_meta
  api_meta=$(cat "${metadata_tmp}")
  rm -f "${metadata_tmp}"

  # Extract fields for DB insertion
  local token title title_jpn file_count expunged tags rating
  token=$(jq -r '.token' <<<"${api_meta}")
  title=$(jq -r '.title' <<<"${api_meta}")
  title_jpn=$(jq -r '.title_jpn' <<<"${api_meta}")
  file_count=$(jq -r '.filecount' <<<"${api_meta}")
  expunged=$(jq -r 'if .expunged then 1 else 0 end' <<<"${api_meta}")
  tags=$(jq -c '.tags' <<<"${api_meta}") # Store as JSON array string
  rating=$(jq -r '.rating' <<<"${api_meta}")

  log "Updating database for GID: ${gid}"

  db_query \
    ".parameter set :gid ${gid}" \
    ".parameter set :token $(db_escape "${token}")" \
    ".parameter set :title $(db_escape "${title}")" \
    ".parameter set :title_jpn $(db_escape "${title_jpn}")" \
    ".parameter set :file_count ${file_count}" \
    ".parameter set :expunged ${expunged}" \
    ".parameter set :tags '${tags}'" \
    ".parameter set :rating ${rating}" \
    ".parameter set :file_path $(db_escape "${db_field_file_path}")" \
    ".parameter set :updated_at '$(date -u +"%Y-%m-%dT%H:%M:%SZ")'" \
    'INSERT INTO galleries (
       gid, token, title, title_jpn, file_count, expunged, tags, rating, file_path, updated_at
     ) VALUES (
       :gid, :token, :title, :title_jpn, :file_count, :expunged, :tags, :rating, :file_path, :updated_at
     )
     ON CONFLICT(gid) DO UPDATE SET
       token = excluded.token,
       title = excluded.title,
       title_jpn = excluded.title_jpn,
       file_count = excluded.file_count,
       expunged = excluded.expunged,
       tags = excluded.tags,
       rating = excluded.rating,
       file_path = excluded.file_path,
       updated_at = excluded.updated_at;'

  rm -rf "${tmp_dir}" "${gallery_dir}"
  log "Successfully archived: ${gallery_dir}"
}

# yomiko rate <gid> <1~10>
cmd_rate() {
  local gid="${1:-}"
  local rating="${2:-}"

  if [[ -z "${gid}" || -z "${rating}" ]]; then
    log_err "Missing GID or rating."
    exit 1
  fi

  if [[ ! "${rating}" =~ ^([1-9]|10)$ ]]; then
    log_err "Invalid rating '${rating}'. Must be 1 through 10."
    exit 2
  fi

  log "Rating gallery ${gid} as ${rating}..."

  local token
  if ! token=$(exh_get_token_by_gid "${gid}"); then
    log_err "Failed to get token for GID: ${gid}"
    exit 3
  fi

  if ! exh_rate "${gid}" "${token}" "${rating}"; then
    log_err "Failed to rate GID ${gid}."
    exit 4
  fi

  log "Successfully rated GID ${gid} as ${rating}."
}

# yomiko pull <gid>
cmd_pull() {
  local gid="${1:-}"
  if [[ -z "${gid}" ]]; then
    log_err "Missing GID to pull."
    exit 1
  fi

  log "Requesting download for GID: ${gid}"

  local token
  if ! token=$(exh_get_token_by_gid "${gid}"); then
    log_err "Failed to get token for GID: ${gid}"
    exit 2
  fi

  if ! exh_request_hath_download "${gid}" "${token}"; then
    log_err "Failed to request download for GID: ${gid}"
    exit 3
  fi

  log "Download successfully requested for GID: ${gid}"
}

# yomiko favorite <gid> <0~9>
# Logic: Adds gallery to specified ExHentai favorites category
cmd_favorite() {
  local gid="${1:-}"
  local favcat="${2:-}"

  if [[ -z "${gid}" || -z "${favcat}" ]]; then
    log_err "Missing GID or favcat."
    exit 1
  fi

  if [[ ! "${favcat}" =~ ^[0-9]$ ]]; then
    log_err "Invalid favcat '${favcat}'. Must be 0 through 9."
    exit 2
  fi

  log "Adding GID ${gid} to favorite category ${favcat}"

  local token
  if ! token=$(exh_get_token_by_gid "${gid}"); then
    log_err "Failed to get token for GID: ${gid}"
    exit 3
  fi

  if ! exh_add_favorite "${gid}" "${token}" "${favcat}"; then
    log_err "Failed to add GID ${gid} to favorites."
    exit 4
  fi

  log "Successfully added GID ${gid} to favorites category ${favcat}."
}

# yomiko feedback <gid> [--rating=<1-11>] [--favorite=<0-9>] [--dry-run]
cmd_feedback() {
  local gid=""
  local rating=""
  local favcat=""
  local dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --rating=*)
      rating="${1#*=}"
      shift
      ;;
    --rating)
      rating="${2:-}"
      shift 2
      ;;
    --favorite=*)
      favcat="${1#*=}"
      shift
      ;;
    --favorite)
      favcat="${2:-}"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -*)
      log_err "Unknown option: $1"
      exit 1
      ;;
    *)
      if [[ -z "${gid}" ]]; then
        gid="$1"
      else
        log_err "Unexpected argument: $1"
        exit 1
      fi
      shift
      ;;
    esac
  done

  if [[ -z "${gid}" ]]; then
    log_err "Missing GID for feedback. Usage: yomiko feedback <gid> [options]"
    exit 1
  fi

  if [[ -n "${rating}" && ! "${rating}" =~ ^([1-9]|10|11)$ ]]; then
    log_err "Invalid rating '${rating}'. Must be 1 through 11."
    exit 2
  fi

  if [[ -n "${favcat}" && ! "${favcat}" =~ ^[0-9]$ ]]; then
    log_err "Invalid favorite category '${favcat}'. Must be 0 through 9."
    exit 3
  fi

  log "Ready to execute feedback logic for GID: ${gid} (Rating: ${rating:-none}, Favorite: ${favcat:-none}, Dry Run: ${dry_run})"

  # --- Feedback Specification ---
  #
  # 1. API Requests (if not --dry-run):
  #    - Rating:
  #      - Provide the rating to ExHentai API.
  #      - If user rating is 11, submit 10 to the API.
  #      - Else, submit the user rating directly (1-10).
  #    - Favorite:
  #      - If user rating is >= 8 (8-11), submit a favorite request.
  #      - (Requires --favorite=<0-9> to be provided).
  #
  # 2. Database Updates (if not --dry-run):
  #    Always update:
  #    - galleries.self_rating = <user_rating> (1-11)
  #    - galleries.feedbacked_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
  #
  #    Conditionally update:
  #    - If user rating <= 10 (1-10):
  #      - galleries.rated_then_deleted_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
  #      - Disk Update: Delete the local archive file from disk which is located in `$HATH_DOWNLOAD_DIR`
  #        and the file path can get from `galleries.file_path`
  # ------------------------------------

  local db_record token file_path
  db_record=$(db_query_json \
    ".parameter set :gid ${gid}" \
    "SELECT token, file_path FROM galleries WHERE gid = :gid;")
  if [[ -z "${db_record}" || "${db_record}" == "[]" ]]; then
    log_err "Gallery GID ${gid} not found in database."
    exit 4
  fi

  token=$(jq -r '.[0].token // empty' <<<"${db_record}")
  file_path=$(jq -r '.[0].file_path // empty' <<<"${db_record}")

  # 1. API Requests
  if [[ -n "${rating}" ]]; then
    local api_rating="${rating}"
    if [[ "${rating}" -eq 11 ]]; then
      api_rating=10
    fi

    if [[ "${dry_run}" -eq 0 ]]; then
      log "Submitting rating ${api_rating} for GID ${gid}..."
      if ! exh_rate "${gid}" "${token}" "${api_rating}"; then
        log_err "Failed to rate GID ${gid}."
      fi
    else
      log "[Dry Run] Would rate GID ${gid} as ${api_rating} (User rating: ${rating})"
    fi

    if [[ "${rating}" -ge 8 && -n "${favcat}" ]]; then
      if [[ "${dry_run}" -eq 0 ]]; then
        log "Submitting favorite ${favcat} for GID ${gid}..."
        if ! exh_add_favorite "${gid}" "${token}" "${favcat}"; then
          log_err "Failed to add GID ${gid} to favorites category ${favcat}."
        fi
      else
        log "[Dry Run] Would add GID ${gid} to favorites category ${favcat}"
      fi
    fi
  fi

  # 2. Database & Disk Updates
  if [[ "${dry_run}" -eq 0 ]]; then
    local sql
    if [[ -n "${rating}" ]]; then
      if [[ "${rating}" -le 10 ]]; then
        sql="UPDATE galleries SET
          feedbacked_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
          self_rating = :rating,
          rated_then_deleted_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'))
        WHERE gid = :gid;"
      else
        sql="UPDATE galleries SET
          feedbacked_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')),
          self_rating = :rating
        WHERE gid = :gid;"
      fi
    else
      sql="UPDATE galleries SET feedbacked_at = (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')) WHERE gid = :gid;"
    fi

    log "Updating database for GID ${gid}..."
    if [[ -n "${rating}" ]]; then
      db_query \
        ".parameter set :rating ${rating}" \
        ".parameter set :gid ${gid}" \
        "${sql}"
    else
      db_query \
        ".parameter set :gid ${gid}" \
        "${sql}"
    fi

    if [[ -n "${rating}" && "${rating}" -le 10 && -n "${file_path}" ]]; then
      # shellcheck disable=SC2153
      local archive_file="${ARCHIVED_DIR}/${file_path}"
      if [[ ! -f "${archive_file}" ]]; then
        log_err "Archive file not found: ${archive_file}"
        exit 5
      fi
      log "Deleting local file: ${archive_file}"
      rm -f "${archive_file}"
    fi

    log "Feedback processed successfully for GID ${gid}."
  else
    log "[Dry Run] Would update database for GID ${gid}"
    if [[ -n "${rating}" && "${rating}" -le 10 && -n "${file_path}" ]]; then
      # shellcheck disable=SC2153
      log "[Dry Run] Would delete file: ${ARCHIVED_DIR}/${file_path}"
    fi
  fi
}

# yomiko list [gid ...] [opts]
cmd_list() {
  local max_count=50
  local format="json"
  local gids=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --max-count=*)
      max_count="${1#*=}"
      shift
      ;;
    --max-count)
      max_count="$2"
      shift 2
      ;;
    --format=*)
      format="${1#*=}"
      shift
      ;;
    --format)
      format="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      gids+=("$1")
      shift
      ;;
    esac
  done

  # Build SQL query
  local sql="SELECT * FROM galleries ORDER BY gid LIMIT :max_count;"
  if [[ ${#gids[@]} -gt 0 ]]; then
    local gid_prepared_list
    gid_prepared_list=$(
      jq -nr --arg gids "${gids[*]}" '$gids | split(" ") | map(select(test("^\\d+$"))) | join(",")'
    )
    sql="SELECT * FROM galleries WHERE gid IN (${gid_prepared_list}) ORDER BY gid LIMIT :max_count;"
  fi

  if [[ "$format" == "json" ]]; then
    db_query_json \
      ".parameter set :max_count ${max_count}" \
      "$sql"
  elif [[ "$format" == "table" ]]; then
    log_err "TODO: Table format is not implemented yet."
    exit 1
  else
    log_err "Invalid format: $format"
    exit 1
  fi
}

# endregion Command Implementations

# region CLI entry

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

COMMAND="$1"
shift

case "${COMMAND}" in
login) cmd_login "$@" ;;
whoami) cmd_whoami "$@" ;;
scan) cmd_scan "$@" ;;
archive) cmd_archive "$@" ;;
rate) cmd_rate "$@" ;;
pull) cmd_pull "$@" ;;
favorite) cmd_favorite "$@" ;;
feedback) cmd_feedback "$@" ;;
list) cmd_list "$@" ;;
help | --help | -h) usage ;;
*)
  echo "Unknown command: $COMMAND"
  usage
  exit 1
  ;;
esac

# endregion CLI entry
